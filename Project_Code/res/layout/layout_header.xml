<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/header_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_white"
    android:elevation="2dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="20dp"
    android:paddingTop="14dp"
    android:paddingEnd="20dp"
    android:paddingBottom="14dp">

    <!-- Transparent Medical Logo -->
    <ImageView
        android:id="@+id/iv_header_logo"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:contentDescription="DiabeticAI Logo"
        android:src="@drawable/ic_diabetic_logo" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- App Name -->
        <TextView
            android:id="@+id/tv_header_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="DiabeticAI"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Subtitle -->
        <TextView
            android:id="@+id/tv_header_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:text="AI-Powered Personalized Healthcare"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Medical Verified Badge / Bell Icon -->
    <ImageView
        android:id="@+id/iv_header_status"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:background="@drawable/bg_chip_healthy"
        android:contentDescription="Active Status"
        android:padding="5dp"
        android:src="@drawable/ic_care"
        app:tint="@color/status_healthy" />
</LinearLayout>
