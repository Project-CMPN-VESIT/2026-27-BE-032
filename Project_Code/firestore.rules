rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, create, update, delete: if isOwner(uid);

      match /{collectionName}/{documentId} {
        allow read, create, update, delete: if isOwner(uid)
          && collectionName in [
            'predictions',
            'assessments',
            'retina_scans',
            'foot_scans',
            'care_plans'
          ];
      }
    }
  }
}
