<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light_slate">

    <!-- Reusable Top Header -->
    <include
        android:id="@+id/header_view"
        layout="@layout/layout_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true" />

    <!-- Fragment Container View for Dynamic Content -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/nav_host_fragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/footer_container"
        android:layout_below="@id/header_view" />

    <!-- Footer & Floating Bottom Navigation Container -->
    <LinearLayout
        android:id="@+id/footer_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/bg_white"
        android:orientation="vertical">

        <!-- Footer -->
        <include
            android:id="@+id/footer_view"
            layout="@layout/layout_footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Floating Rounded Bottom Navigation Bar -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_bottom_nav"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/bg_white"
            app:cardCornerRadius="32dp"
            app:cardElevation="10dp"
            app:strokeColor="@color/card_border"
            app:strokeWidth="1dp">

            <com.google.android.material.bottomnavigation.BottomNavigationView
                android:id="@+id/bottom_navigation"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                app:elevation="0dp"
                app:itemIconSize="24dp"
                app:itemIconTint="@color/primary_blue"
                app:itemRippleColor="@color/accent_teal_light"
                app:itemTextColor="@color/text_primary"
                app:labelVisibilityMode="labeled"
                app:menu="@menu/bottom_nav_menu" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</RelativeLayout>
